WITH NETFLIXTABLE AS (
    SELECT
        TYPE,
        TITLE,
        COUNTRY,
        RELEASE_YEAR,
        DURATION
    FROM {{ source('netflix', 'NETFLIXTABLE') }}
),

IMDBTABLE AS (
    SELECT
        CERTIFICATE,
        SERIES_TILE AS SERIES_TITLES,
        IMDB_RATING,
        META_SCORE
    FROM {{ source('netflix', 'IMDBTABLE') }}
)

SELECT
    n.TYPE,
    n.TITLE,
    n.COUNTRY,
    n.RELEASE_YEAR,
    n.DURATION,
    i.CERTIFICATE,
    i.IMDB_RATING,
    i.META_SCORE
FROM NETFLIXTABLE n
INNER JOIN IMDBTABLE i
    ON n.TITLE = i.SERIES_TITLES
